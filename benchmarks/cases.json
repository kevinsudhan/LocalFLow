[
  {
    "id": "plain-statement",
    "group": "normal",
    "input": "the shipment has been delayed by two days",
    "expected": "The shipment has been delayed by two days."
  },
  {
    "id": "plain-question",
    "group": "normal",
    "input": "can you send this today",
    "expected": "Can you send this today?"
  },
  {
    "id": "greeting",
    "group": "normal",
    "input": "hello John how are you",
    "must_contain": [
      "Hello John"
    ],
    "must_match": [
      "[?.]$"
    ]
  },
  {
    "id": "fillers-hesitation",
    "group": "fillers",
    "input": "uh can you send Rahul the quotation tomorrow",
    "must_not_contain": [
      "uh "
    ],
    "must_contain": [
      "Rahul",
      "quotation"
    ]
  },
  {
    "id": "fillers-discourse",
    "group": "fillers",
    "input": "so, you know, the container is, like, still at customs",
    "must_not_contain": [
      "you know"
    ],
    "must_contain": [
      "container",
      "customs"
    ]
  },
  {
    "id": "fillers-meaningful-actually",
    "group": "fillers",
    "input": "The actual figure was higher than the estimate.",
    "must_contain": [
      "actual figure"
    ]
  },
  {
    "id": "fillers-kind-of-noun",
    "group": "fillers",
    "input": "I need a kind of folder that seals properly.",
    "must_contain": [
      "kind of folder"
    ]
  },
  {
    "id": "correction-weekday",
    "group": "correction",
    "input": "I'll send it Monday... actually Tuesday.",
    "must_contain": [
