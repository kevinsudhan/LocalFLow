    ],
    "must_not_contain": [
      "Chennai"
    ]
  },
  {
    "id": "correction-amount",
    "group": "correction",
    "input": "The total is 500, I meant 5000.",
    "must_contain": [
      "5000"
    ],
    "must_not_contain": [
      "I meant"
    ]
  },
  {
    "id": "correction-mid-sentence",
    "group": "correction",
    "input": "can you send Rahul the quotation tomorrow, actually no, Friday, and tell him customs has delayed the shipment",
    "must_contain": [
      "Friday",
      "Rahul",
      "customs"
    ],
    "must_not_contain": [
      "tomorrow",
      "actually"
    ]
  },
  {
    "id": "numbers-preserved",
    "group": "numbers",
    "input": "the invoice total is 4500 rupees due on the 15th of March",
    "must_contain": [
      "4500",
      "15th",
      "March"
    ]
  },
  {
    "id": "numbers-not-a-list",
